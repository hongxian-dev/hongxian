{
  "name": "@hongxian/server",
  "version": "0.1.0",
  "description": "红线平台服务参考实现：加密信箱 + 广场哑管道（Hono，零知识，AGPL-3.0，docker 一键自托管）",
  "license": "AGPL-3.0-only",
  "author": "Hongxian contributors (https://hongxian.dev)",
  "homepage": "https://hongxian.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongxian-dev/hongxian.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/hongxian-dev/hongxian/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hongxian-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@hongxian/schema": "0.1.0",
    "@hono/node-server": "^1.13.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "hono": "^4.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
