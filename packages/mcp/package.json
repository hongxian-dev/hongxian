{
  "name": "@hongxian/mcp",
  "version": "0.1.0",
  "description": "月老 Yuelao MCP Server：寄生在宿主 Agent 里的红线工具包（12 tools + 4 prompts，STDIO，零服务端）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hongxian-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hongxian/core": "0.1.0",
    "@hongxian/crypto": "0.1.0",
    "@hongxian/schema": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "qrcode": "^1.5.4"
  },
  "publishConfig": {
    "provenance": true
  }
}
